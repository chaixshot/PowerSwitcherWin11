<Controls:FluentWindow
    x:Class="PowerSwitcher.TrayApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Controls="clr-namespace:Wpf.Ui.Controls;assembly=Wpf.Ui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ext="clr-namespace:PowerSwitcher.TrayApp.Extensions"
    xmlns:local="clr-namespace:PowerSwitcher.TrayApp"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="clr-namespace:PowerSwitcher.TrayApp.ViewModels"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    x:Name="SchemasWindow"
    Title="Power switcher"
    Width="360"
    MinWidth="0"
    MinHeight="0"
    Background="Transparent"
    Deactivated="Window_Deactivated"
    ExtendsContentIntoTitleBar="True"
    Left="-500"
    PreviewKeyDown="Window_PreviewKeyDown"
    RenderOptions.ClearTypeHint="Enabled"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextRenderingMode="ClearType"
    Topmost="True"
    WindowBackdropType="Acrylic"
    WindowStyle="None"
    mc:Ignorable="d">

    <Controls:FluentWindow.DataContext>
        <viewModels:MainWindowViewModel x:Name="ViewModel" />
    </Controls:FluentWindow.DataContext>

    <d:Window.DataContext>
        <viewModels:MainWindowViewModelDesign />
    </d:Window.DataContext>

    <Window.Resources>
        <ext:PowerSchemaIconConverter x:Key="PowerSchemaIconConverter" />
        <ext:InvertableVisibilityConverter x:Key="InvertableVisibilityConverter" />
        <Style BasedOn="{StaticResource ListViewItemStyle}" TargetType="{x:Type wpfui:ListViewItem}">
            <Setter Property="FocusVisualStyle">
                <Setter.Value>
                    <x:Null />
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border
        x:Name="MainPanel"
        BorderBrush="{wpfui:ThemeResource ControlElevationBorderBrush}"
        BorderThickness="1"
        ClipToBounds="True"
        CornerRadius="8">
        <StackPanel>
            <StackPanel Margin="16,14,16,8" Orientation="Horizontal">
                <Controls:TextBlock
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Text="Power Options" />
                <StackPanel
                    x:Name="hotkeyButton"
                    Margin="8,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Border
                        MinHeight="20"
                        Padding="5,2"
                        VerticalAlignment="Center"
                        Background="{wpfui:ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        BorderBrush="{wpfui:ThemeResource ControlElevationBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <Controls:SymbolIcon
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Filled="True"
                            FontSize="11"
                            Foreground="{wpfui:ThemeResource TextPlaceholderColorBrush}"
                            Symbol="TableSimple48" />
                    </Border>

                    <Controls:TextBlock
                        Height="16"
                        Margin="3,0,3,0"
                        VerticalAlignment="Center"
                        FontSize="10"
                        Foreground="{wpfui:ThemeResource TextPlaceholderColorBrush}"
                        Text="+" />

                    <Border
                        MinHeight="20"
                        Padding="6,2"
                        VerticalAlignment="Center"
                        Background="{wpfui:ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        BorderBrush="{wpfui:ThemeResource ControlElevationBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <Controls:TextBlock
                            VerticalAlignment="Center"
                            FontSize="10"
                            FontWeight="Medium"
                            Foreground="{wpfui:ThemeResource TextPlaceholderColorBrush}"
                            Text="Shift"
                            TextAlignment="Center" />
                    </Border>

                    <Controls:TextBlock
                        Height="16"
                        Margin="3,0,3,0"
                        VerticalAlignment="Center"
                        FontSize="10"
                        Foreground="{wpfui:ThemeResource TextPlaceholderColorBrush}"
                        Text="+" />

                    <Border
                        MinWidth="20"
                        MinHeight="20"
                        Padding="6,2"
                        VerticalAlignment="Center"
                        Background="{wpfui:ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        BorderBrush="{wpfui:ThemeResource ControlElevationBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <Controls:TextBlock
                            VerticalAlignment="Center"
                            FontSize="10"
                            FontWeight="Medium"
                            Foreground="{wpfui:ThemeResource TextPlaceholderColorBrush}"
                            Text="L"
                            TextAlignment="Center" />
                    </Border>
                </StackPanel>
            </StackPanel>

            <Controls:ListView
                x:Name="ElementsList"
                Margin="6,4,6,4"
                Focusable="False"
                IsSynchronizedWithCurrentItem="False"
                ItemsSource="{Binding Schemas}"
                KeyboardNavigation.TabNavigation="Cycle"
                SelectedItem="{Binding ActiveSchema}"
                SelectionMode="Single">
                <Controls:ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="4,6,4,6" MouseLeftButtonDown="Label_MouseLeftButtonDown">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Grid.Column="0"
                                Width="32"
                                Height="28"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{wpfui:ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                CornerRadius="4">
                                <Controls:SymbolIcon
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    Foreground="{wpfui:ThemeResource TextFillColorPrimaryBrush}"
                                    Symbol="{Binding ., Converter={StaticResource PowerSchemaIconConverter}}" />
                            </Border>
                            <StackPanel
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center">
                                <Controls:TextBlock
                                    FontSize="13"
                                    FontWeight="Normal"
                                    Text="{Binding Name}" />
                                <Controls:TextBlock
                                    Margin="0,2,0,0"
                                    FontSize="11"
                                    Foreground="{wpfui:ThemeResource TextPlaceholderColorBrush}"
                                    Text="Active power plan"
                                    Visibility="{Binding IsActive, Converter={StaticResource InvertableVisibilityConverter}, ConverterParameter=Normal}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </Controls:ListView.ItemTemplate>
            </Controls:ListView>

            <Border BorderBrush="{wpfui:ThemeResource ControlElevationBorderBrush}" BorderThickness="0,1,0,0">
                <Controls:Button
                    x:Name="OpenPowerOption"
                    Padding="16,15"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    Background="Transparent"
                    Click="OpenPowerOption_Click"
                    CornerRadius="0,0,8,8"
                    Cursor="Hand">
                    <Controls:Button.Content>
                        <Controls:TextBlock
                            FontSize="12"
                            Foreground="{wpfui:ThemeResource TextPlaceholderColorBrush}"
                            Text="Open power options" />
                    </Controls:Button.Content>
                </Controls:Button>
            </Border>
        </StackPanel>
    </Border>

</Controls:FluentWindow>
